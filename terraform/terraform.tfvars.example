# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

name   = "winvm"
region = "us-east-1"

# 4 vCPU / 8 GiB exactly. c7i.xlarge is the newer generation at a similar price.
instance_type = "c6i.xlarge"

root_volume_size = 100

# Contents of your public key file, for example ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Your own address only. `vm allow-ip` adds your current address later without
# a terraform run, so this just needs to be right on the day you build.
allowed_cidrs = ["203.0.113.4/32"]

# HTTPS URL of this repository. The instance clones it at first boot.
setup_repo_url = "https://github.com/kiyeonjeon21/aws-windows-vm.git"
setup_ref      = "main"

enable_rdp    = false
associate_eip = true

idle_shutdown_minutes       = 30
idle_shutdown_cpu_threshold = 15
